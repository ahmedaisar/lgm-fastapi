# Copy to .env and fill in. Portal creds = ONE shared agency login.
# Secrets are read from the environment only — no fallbacks in source.
PORTAL_BASE_URL=https://unihotel.org
PORTAL_LOGIN_PATH=/ajax-login/
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Agency rate code for pricing (account-specific; 72XCP verified on unihotel.org)
PORTAL_RATE_CODE=72XCP
# Session / guard tuning
MAX_CONCURRENT_PORTAL_REQUESTS=4
PORTAL_TIMEOUT_SECONDS=30
# Cap on how many portal result parts one /search may crawl (1-200)
MAX_SEARCH_PARTS=50
# Sell-price markup percent over portal net room prices (transfers untouched)
MARKUP=10
# --- Public API hardening (all optional; unset = previous open behaviour) ---
# Comma-separated API keys; when set, /search & /hotels/* require X-API-Key
API_KEYS=
# Per-IP requests/minute for /search & /hotels/*; 0 disables
RATE_LIMIT_PER_MINUTE=0
# Comma-separated allowed browser origins; empty sends no CORS headers
CORS_ORIGINS=
# Set false to hide /docs + /openapi.json on public deployments
DOCS_ENABLED=true
# Multipart upload cap for POST /admin/import (bytes)
UPLOAD_MAX_BYTES=2000000
# --- Admin CMS (single admin role). Unset = /admin/* answers 503, app still boots.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Use >= 32 random chars (python -c "import secrets;print(secrets.token_hex(32))"),
# or PyJWT warns about weak HMAC keys. Unset = ephemeral secret per restart.
ADMIN_JWT_SECRET=change-me-too-but-at-least-32-chars-long
ADMIN_TOKEN_TTL_HOURS=12
# --- CMS store writability ---
# 1 = refuse CMS writes with 409 (immutable deploys). Auto-enabled on Vercel
# (VERCEL=1), where the filesystem is read-only and data/cms.json can't persist.
CMS_READ_ONLY=0
# --- Misc ---
LOG_LEVEL=info
NATIONALITY_MAPPING_PATH=lib/data/nationality_mapping.json
PORT=8000
# Uvicorn workers (keep 1: the CMS JSON store write-lock is per-process)
WEB_CONCURRENCY=1
# CMS JSON file store (committed source of truth; commit after big imports)
CMS_JSON_PATH=data/cms.json
